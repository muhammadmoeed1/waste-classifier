# Python
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environment
.env

# Dataset (download separately per README, not committed)
data/dataset/

# Local SQLite dev database (see DATABASE_URL in config.py)
data/app.db

# Large training history not needed for the repo
artifacts/metrics/training_history.json

# Model weights (~37MB) -- published as a GitHub Release asset instead
# (see scripts/fetch_artifacts.py) so future commits don't keep bloating the
# repo with binaries. class_names.json stays tracked (tiny, useful to browse
# on GitHub); the .onnx files are regenerable via ml/export_onnx.py.
artifacts/waste_model.keras
artifacts/waste_model.onnx
artifacts/waste_model_quant.onnx

# Retrained model versions (scripts/retrain.py) -- same reasoning as above.
# A version worth keeping should be promoted (copied over the flat production
# path) or published as its own Release asset, not committed here.
artifacts/models/

# Human-curated retraining input / its validated output (scripts/build_correction_set.py) --
# real photos, not something to commit; see that script's docstring.
data/corrections/
data/corrections_processed/

# Pretrained YOLOv8n weights (auto-downloaded by ultralytics on first use;
# re-fetchable from https://github.com/ultralytics/assets, not our own artifact)
yolov8n.pt

# Local dev tools (e.g. cloudflared.exe for ad-hoc tunneling), not a project artifact
.tools/

# OS
.DS_Store
Thumbs.db
