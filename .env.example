# Copy this file to .env and fill in your values. Every one of these has a
# sensible default in src/waste_classifier/config.py -- only set what you
# actually need to change.

# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# CORS origins allowed to call the API, comma-separated (use * for local dev)
CORS_ORIGINS=*

# --- Persistence ---
# Local SQLite by default. In production, point this at Postgres instead --
# free-tier hosts like Render have an ephemeral filesystem, so SQLite loses
# all data on every redeploy. Example: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=

# --- Optional: model / region variants ---
# Selects a version under artifacts/models/{version}/ produced by
# scripts/retrain.py, instead of the flat production model. Leave unset to
# use the flat production path.
# MODEL_VERSION=

# "generic" (default) or "pk" -- swaps in Pakistan-localized disposal
# guidance (the informal kabaria/scrap-dealer resale economy) for the RAG
# knowledge base and assistant system prompt.
# REGION=pk

# "embeddings" (default, needs sentence-transformers/FAISS/torch) or "tfidf"
# (lightweight, used by the free-tier docker/Dockerfile.lite profile).
# RAG_BACKEND=tfidf

# Skip Grad-CAM's extra gradient pass -- set to true on memory-constrained hosts.
# DISABLE_GRADCAM=false
